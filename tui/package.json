{
  "name": "bindertui",
  "version": "0.1.0",
  "description": "Tabbed TUI for a single headless Claude Code session",
  "type": "module",
  "bin": {
    "binder": "./bin/binder.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bench": "NODE_ENV=production tsx test/perf/bench.tsx"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/ws": "^8.18.2",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "cli-highlight": "^2.1.11",
    "ink": "^8.0.0",
    "marked": "^15.0.12",
    "react": "^19.3.0",
    "slice-ansi": "^9.0.1",
    "string-width": "^8.3.0",
    "wrap-ansi": "^10.0.2",
    "ws": "^8.22.0"
  }
}
