{
  "name": "bindergui",
  "productName": "Binder",
  "version": "0.1.0",
  "description": "Mac app for binder: Claude Code sessions in tabs, with rendered Markdown",
  "main": "out/main/index.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "e2e": "electron-vite build && playwright test",
    "dist": "electron-vite build && electron-builder --mac --dir",
    "icon": "node scripts/make-icon.mjs",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-*/spawn-helper"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "highlight.js": "^11.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "dev.bindertui.binder",
    "productName": "Binder",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**"
    ],
    "mac": {
      "target": "dir",
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false
    },
    "asarUnpack": [
      "node_modules/node-pty/**"
    ]
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  }
}
